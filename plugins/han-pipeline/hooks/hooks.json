{
  "description": "han-pipeline 실행 중에만 동작: 사람만 하는 명령(배포 브랜치 머지·push, force push, DB 적용·직접 쿼리, 운영 배포)과 통합·배포 브랜치에 바로 하는 커밋·통합 브랜치 push 를 막고, 커밋·PR 생성 전에 han.mjs check 통과를 확인한다. git·gh·DB·배포 명령일 때만 프로세스가 뜬다.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git commit*)",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/guard.mjs\"",
            "timeout": 30
          },
          {
            "type": "command",
            "if": "Bash(git push*)",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/guard.mjs\"",
            "timeout": 30
          },
          {
            "type": "command",
            "if": "Bash(git merge*)",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/guard.mjs\"",
            "timeout": 30
          },
          {
            "type": "command",
            "if": "Bash(gh pr*)",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/guard.mjs\"",
            "timeout": 30
          },
          {
            "type": "command",
            "if": "Bash(supabase*)",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/guard.mjs\"",
            "timeout": 30
          },
          {
            "type": "command",
            "if": "Bash(npx supabase*)",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/guard.mjs\"",
            "timeout": 30
          },
          {
            "type": "command",
            "if": "Bash(psql*)",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/guard.mjs\"",
            "timeout": 30
          },
          {
            "type": "command",
            "if": "Bash(mysql*)",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/guard.mjs\"",
            "timeout": 30
          },
          {
            "type": "command",
            "if": "Bash(sqlcmd*)",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/guard.mjs\"",
            "timeout": 30
          },
          {
            "type": "command",
            "if": "Bash(mongosh*)",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/guard.mjs\"",
            "timeout": 30
          },
          {
            "type": "command",
            "if": "Bash(flyway*)",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/guard.mjs\"",
            "timeout": 30
          },
          {
            "type": "command",
            "if": "Bash(prisma*)",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/guard.mjs\"",
            "timeout": 30
          },
          {
            "type": "command",
            "if": "Bash(npx prisma*)",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/guard.mjs\"",
            "timeout": 30
          },
          {
            "type": "command",
            "if": "Bash(drizzle-kit*)",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/guard.mjs\"",
            "timeout": 30
          },
          {
            "type": "command",
            "if": "Bash(npx drizzle-kit*)",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/guard.mjs\"",
            "timeout": 30
          },
          {
            "type": "command",
            "if": "Bash(vercel*)",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/guard.mjs\"",
            "timeout": 30
          },
          {
            "type": "command",
            "if": "Bash(npx vercel*)",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/guard.mjs\"",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "PowerShell",
        "hooks": [
          {
