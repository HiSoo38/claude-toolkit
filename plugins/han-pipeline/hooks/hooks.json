            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/guard.mjs\"",
            "timeout": 30
          },
          {
            "type": "command",
            "if": "PowerShell(mongosh*)",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/guard.mjs\"",
            "timeout": 30
          },
          {
            "type": "command",
            "if": "PowerShell(flyway*)",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/guard.mjs\"",
            "timeout": 30
          },
          {
            "type": "command",
            "if": "PowerShell(prisma*)",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/guard.mjs\"",
            "timeout": 30
          },
          {
            "type": "command",
            "if": "PowerShell(npx prisma*)",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/guard.mjs\"",
            "timeout": 30
          },
          {
            "type": "command",
            "if": "PowerShell(drizzle-kit*)",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/guard.mjs\"",
            "timeout": 30
          },
          {
            "type": "command",
            "if": "PowerShell(npx drizzle-kit*)",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/guard.mjs\"",
            "timeout": 30
          },
          {
            "type": "command",
            "if": "PowerShell(vercel*)",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/guard.mjs\"",
